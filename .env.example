# Copy to .env next to docker-compose.yml and fill in. docker compose reads
# .env automatically and passes these values to the backend container.

# Host folder that holds your "media" folder; ${MEDIA}/media is mounted at
# /media. Use the same value as the MEDIA your Jellyfin/Plex stacks use.
MEDIA=/srv

# ---------- Translators ----------
# Gemini (leave the key empty to turn Gemini off)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Local models through llama-swap's OpenAI-compatible API.
# The URL is called from inside the backend container: use the llama-swap
# host's LAN address, not localhost. The model picker lists what llama-swap
# serves from GET <TRANSLATE_GEMMA_URL>/v1/models (the OpenAI-compatible list
# Open WebUI also reads); TRANSLATE_GEMMA_MODEL is the default choice.
TRANSLATE_GEMMA_URL=http://192.168.1.163:8080
TRANSLATE_GEMMA_MODEL=translatemgemma
TRANSLATE_GEMMA_API_KEY=random_key
# Default translator when none is chosen: "translatemgemma" (local) or "gemini"
TRANSLATOR_BACKEND=translatemgemma

# ---------- Media servers (fill in one or both) ----------
# Also called from inside the backend container, so use an address it can
# reach: the server's LAN address, or its service name if it is on the same
# Docker network (e.g. http://jellyfin:8096).
#
# *_PATH_MAP turns the file paths the media server reports into paths under
# /media in this container: comma-separated server_path:backend_path pairs.
# Jellyfin and Plex both mount ${MEDIA}:/data, and this backend mounts
# ${MEDIA}/media:/media, so /data/media/... on the server is /media/... here.

# Jellyfin: Dashboard > API Keys > +
JELLYFIN_URL=http://192.168.1.163:8096
JELLYFIN_API_KEY=
JELLYFIN_PATH_MAP=/data/media:/media

# Plex: X-Plex-Token from any item's "Get Info > View XML" URL
PLEX_URL=http://192.168.1.163:32400
PLEX_TOKEN=
PLEX_PATH_MAP=/data/media:/media
